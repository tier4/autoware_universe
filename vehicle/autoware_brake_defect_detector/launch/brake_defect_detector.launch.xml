<launch>
  <arg name="config_file" default="$(find-pkg-share autoware_brake_defect_detector)/config/brake_defect_detector.param.yaml"/>
  <arg name="input_control_cmd" default="/control/command/control_cmd"/>
  <arg name="input_actuation_cmd" default="/control/command/actuation_cmd"/>
  <arg name="input_kinematics" default="/localization/kinematic_state"/>
  <arg name="input_measured_acceleration" default="/localization/acceleration"/>

  <node pkg="autoware_brake_defect_detector" exec="brake_defect_detector_node" name="brake_defect_detector" output="screen">
    <param from="$(var config_file)"/>
    <remap from="~/input/control_cmd" to="$(var input_control_cmd)"/>
    <remap from="~/input/actuation_cmd" to="$(var input_actuation_cmd)"/>
    <remap from="~/input/kinematics" to="$(var input_kinematics)"/>
    <remap from="~/input/measured_acceleration" to="$(var input_measured_acceleration)"/>
  </node>
</launch>
