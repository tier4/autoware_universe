{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parameters for autoware_tensorrt_e2e",
  "type": "object",
  "definitions": {
    "tensorrt_e2e": {
      "type": "object",
      "properties": {
        "model_path": {
          "type": "string",
          "description": "Path to the ONNX model. The TensorRT engine is built and cached alongside it."
        },
        "plugins_path": {
          "type": "string",
          "description": "Path to a TensorRT plugin shared library. Empty to disable.",
          "default": ""
        },
        "precision": {
          "type": "string",
          "description": "TensorRT engine precision.",
          "enum": ["fp32", "fp16"],
          "default": "fp16"
        },
        "args_path": {
          "type": "string",
          "description": "Optional normalization JSON in the diffusion planner observation_normalizer format. Empty to disable normalization.",
          "default": ""
        },
        "build_only": {
          "type": "boolean",
          "description": "Shutdown the node after the TensorRT engine file is built.",
          "default": false
        },
        "planning_frequency_hz": {
          "type": "number",
          "description": "Output rate of the planner.",
          "default": 10.0,
          "exclusiveMinimum": 0.0
        },
        "shift_x": {
          "type": "boolean",
          "description": "Use the vehicle center (instead of base_link) as the model reference frame, mirroring the diffusion planner option.",
          "default": false
        },
        "sensor_inputs": {
          "type": "array",
          "items": { "type": "string", "enum": ["camera", "lidar", "bev_feature"] },
          "description": "Enabled sensor input providers.",
          "default": []
        },
        "enable_context_inputs": {
          "type": "boolean",
          "description": "Enable the diffusion-planner-style context input provider (individual tensors are claimed on demand from the engine manifest).",
          "default": true
        },
        "camera": {
          "type": "object",
          "properties": {
            "num_cameras": { "type": "integer", "minimum": 1, "default": 1 },
            "input_width": { "type": "integer", "description": "Camera sensor image width.", "default": 1920 },
            "input_height": { "type": "integer", "description": "Camera sensor image height.", "default": 1280 },
            "image_transport": { "type": "string", "enum": ["raw", "compressed"], "default": "compressed" },
            "ego_frame": { "type": "string", "default": "base_link" },
            "images_tensor": { "type": "string", "default": "camera_images" },
            "intrinsics_tensor": { "type": "string", "default": "camera_intrinsics" },
            "extrinsics_tensor": { "type": "string", "default": "camera2ego" },
            "normalization_mean": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3,
              "description": "Per-channel mean (RGB, 0-255 scale).",
              "default": [123.675, 116.28, 103.53]
            },
            "normalization_std": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3,
              "description": "Per-channel standard deviation (RGB, 0-255 scale).",
              "default": [58.395, 57.12, 57.375]
            },
            "sync_tolerance_ms": { "type": "number", "default": 100.0 },
            "max_delay_ms": { "type": "number", "default": 200.0 },
            "allow_dropped_cameras": {
              "type": "boolean",
              "description": "Zero-fill dropped non-anchor cameras instead of skipping the tick.",
              "default": false
            },
            "anchor_camera_index": { "type": "integer", "minimum": 0, "default": 0 }
          }
        },
        "lidar": {
          "type": "object",
          "properties": {
            "points_tensor": { "type": "string", "default": "points" },
            "num_points_tensor": { "type": "string", "default": "num_points" },
            "max_delay_ms": { "type": "number", "default": 200.0 },
            "intensity_scale": { "type": "number", "default": 1.0 }
          }
        },
        "bev_feature": {
          "type": "object",
          "description": "Temporal LiDAR BEV feature provider (ResWorld-style models).",
          "properties": {
            "history_tensor": { "type": "string", "default": "bev_feature_history" },
            "contract_path": {
              "type": "string",
              "description": "Deployment contract JSON shipped with the model; overrides frames/interval/half extent/feature tensor when set.",
              "default": ""
            },
            "frames": { "type": "integer", "minimum": 2, "default": 3 },
            "interval_seconds": { "type": "number", "default": 0.1 },
            "interval_tolerance_seconds": { "type": "number", "default": 0.02 },
            "bev_half_extent_m": { "type": "number", "default": 122.4 },
            "warmup": { "type": "string", "enum": ["wait", "duplicate_current"], "default": "wait" },
            "max_delay_ms": { "type": "number", "default": 200.0 },
            "extractor": {
              "type": "object",
              "description": "Frozen BEVFusion-L feature extractor (voxelization parameters must match the BEVFusion ml package it was exported from).",
              "properties": {
                "onnx_path": { "type": "string" },
                "plugins_path": { "type": "string" },
                "precision": { "type": "string", "enum": ["fp32", "fp16"], "default": "fp16" },
                "feature_tensor": { "type": "string", "default": "bev_feature" },
                "cloud_capacity": { "type": "integer", "default": 2000000 },
                "max_points_per_voxel": { "type": "integer", "default": 32 },
                "voxels_num": { "type": "array", "items": { "type": "integer" }, "minItems": 3, "maxItems": 3, "default": [1, 128000, 256000] },
                "point_cloud_range": { "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6, "default": [-122.4, -122.4, -3.0, 122.4, 122.4, 5.0] },
                "voxel_size": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "default": [0.17, 0.17, 0.2] },
                "use_intensity": { "type": "boolean", "default": false }
              }
            }
          }
        },
        "context": {
          "type": "object",
          "properties": {
            "traffic_light_group_msg_timeout_seconds": { "type": "number", "default": 0.2 },
            "ignore_neighbors": { "type": "boolean", "default": false },
            "ignore_unknown_neighbors": { "type": "boolean", "default": true },
            "line_string_max_step_m": { "type": "number", "default": 5.0 },
            "use_time_interpolation": { "type": "boolean", "default": false }
          }
        },
        "postprocess": {
          "type": "object",
          "properties": {
            "prediction_tensor": { "type": "string", "default": "prediction" },
            "extra_trajectory_tensors": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Additional ego-only [B, T, 4] trajectory outputs published as extra candidates (e.g. ResWorld's prior_trajectory).",
              "default": []
            },
            "horizon_seconds": { "type": "number", "default": 4.0, "exclusiveMinimum": 0.0 },
            "time_step": {
              "type": "number",
              "description": "Trajectory point interval. Must be 0.1 s (fixed by the reused diffusion planner postprocessing).",
              "const": 0.1,
              "default": 0.1
            },
            "velocity_smoothing_window": { "type": "integer", "minimum": 1, "default": 8 },
            "stopping_threshold": { "type": "number", "default": 0.3 },
            "generator_name": { "type": "string", "default": "TensorrtE2e" }
          }
        }
      },
      "required": ["model_path", "sensor_inputs"]
    }
  },
  "properties": {
    "/**": {
      "type": "object",
      "properties": {
        "ros__parameters": { "$ref": "#/definitions/tensorrt_e2e" }
      },
      "required": ["ros__parameters"]
    }
  },
  "required": ["/**"]
}
