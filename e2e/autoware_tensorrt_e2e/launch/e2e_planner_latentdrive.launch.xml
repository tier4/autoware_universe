<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Deployment defaults from the package, then the model's own description from the
       directory that holds its ONNX (see README, "Configuration layout"). -->
  <arg name="param_path" default="$(find-pkg-share autoware_tensorrt_e2e)/config/e2e_planner.param.yaml"/>
  <arg name="model_path" default="$(env HOME)/autoware_data/ml_models/tensorrt_e2e/latentdrive" description="directory holding the planner ONNX and ml_package_$(var model_name).param.yaml"/>
  <arg name="model_name" default="latentdrive"/>
  <arg name="planner_onnx" default="e2e-idx8-hist4-wp10hz-e3.onnx" description="planner ONNX file name inside model_path"/>
  <arg name="ml_package_param_path" default="$(var model_path)/ml_package_$(var model_name).param.yaml"/>
  <!-- e2e_planner.param.yaml substitutes these for the bev_feature deployment. LatentDrive
       never enables that provider, so the values are not read; they only have to resolve. -->
  <arg name="extractor_onnx" default=""/>
  <arg name="contract_file" default=""/>
  <arg name="vehicle_info_param_path" default="$(find-pkg-share autoware_vehicle_info_utils)/config/vehicle_info.param.yaml"/>
  <arg name="build_only" default="false" description="shutdown node after the TensorRT engine file is built"/>
  <arg name="use_sim_time" default="false" description="clock every node here from /clock, as a bag replay needs"/>
  <arg name="tick_log" default="false" description="one [LatentDrive-debug] INFO line per planning tick: frame ages and status, or why the tick was skipped"/>
  <arg name="smoothing" default="false" description="temporal smoothing of the plan (latentdrive.smoothing.enable); the raw plan stays published as the _raw candidate"/>
  <arg name="rviz" default="false" description="open RViz (the standard Autoware layout)"/>
  <!-- The standard layout draws /planning/trajectory; pass
       output_trajectory:=/planning/trajectory to see this node's output in it. -->
  <arg name="rviz_config" default="$(find-pkg-share autoware_launch)/rviz/autoware.rviz"/>
  <!-- Off by default: a full Autoware stack publishes /robot_description from its vehicle
       launch. Enable it for a standalone replay, where nothing else draws the ego:
       vehicle_model_publisher:=true vehicle_model:=NAME publishes the body from
       NAME_description (see e2e_planner_front_camera.launch.xml for why the body only). -->
  <arg name="vehicle_model" default="" description="vehicle description package prefix, e.g. jpntaxi for jpntaxi_description; draws the ego"/>
  <arg name="vehicle_model_publisher" default="false" description="publish /robot_description for a standalone replay"/>

  <!-- Sensing input: the front camera the model was trained on -->
  <arg name="input_camera0_image" default="/sensing/camera/camera1/image_raw"/>

  <!-- Ego state and the reference the subgoal is taken from. subgoal_source:=route follows the
       route's lanelet centerlines (needs the route and the vector map);
       subgoal_source:=trajectory follows a Trajectory topic, e.g. the recorded planner output
       in a replay whose bags carry no route. -->
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="subgoal_source" default="route" description="route | trajectory"/>
  <arg name="input_route" default="/planning/mission_planning/route"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="input_reference_trajectory" default="/planning/scenario_planning/lane_driving/trajectory"/>

  <arg name="output_trajectory" default="~/output/trajectory"/>
  <arg name="output_trajectories" default="~/output/trajectories"/>
  <arg name="output_predicted_objects" default="~/output/predicted_objects"/>

  <!-- Applies to every node below: the planner measures input staleness against its clock,
       and RViz and the ego publisher follow the same time base. -->
  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <node pkg="autoware_tensorrt_e2e" exec="autoware_tensorrt_e2e_node" name="tensorrt_e2e" output="both">
    <param from="$(var param_path)" allow_substs="true"/>
    <param from="$(var ml_package_param_path)" allow_substs="true"/>
    <param from="$(var vehicle_info_param_path)" allow_substs="true"/>
    <param name="build_only" value="$(var build_only)"/>
    <param name="latentdrive.smoothing.enable" value="$(var smoothing)"/>
    <param name="latentdrive.tick_log" value="$(var tick_log)"/>
    <param name="latentdrive.subgoal_source" value="$(var subgoal_source)"/>
    <remap from="~/input/camera0/image" to="$(var input_camera0_image)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/reference_trajectory" to="$(var input_reference_trajectory)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/output/trajectories" to="$(var output_trajectories)"/>
    <remap from="~/output/predicted_objects" to="$(var output_predicted_objects)"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        output="log" if="$(var vehicle_model_publisher)">
    <param name="robot_description" type="str" value="$(command 'xacro $(find-pkg-share autoware_tensorrt_e2e)/urdf/ego_model.xacro vehicle_urdf:=$(find-pkg-share $(var vehicle_model)_description)/urdf/vehicle.xacro' 'warn')"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config)"
        if="$(var rviz)"/>
</launch>
