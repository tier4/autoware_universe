<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Every jpntaxi release model behind one launch file: pick it with `model`, point `data_path` at its
       release directory (the node files of its WebAuto package release). The topics are the same for all.
         model:=resworld            ResWorld (oneplanner-<x.y.z.a>-jpntaxi): BEV extractor + planner in this node
         model:=mlplanner_1p5stage  ML-Planner 1.5-stage (oneplanner-mlplanner-1p5stage-*): BEV extractor in this
                                    node, plus the tracked objects
         model:=mlplanner_2stage    ML-Planner 2-stage (oneplanner-mlplanner-2stage-*): the tracked objects, as it
                                    was trained (no BEV)
       The models that read a BEV map run BEVFusion-L's extractor inside their own node from the concatenated
       point cloud; none needs a separate BEV node. -->
  <arg name="model" description="resworld | mlplanner_1p5stage | mlplanner_2stage"/>
  <arg name="data_path" description="the model's release directory"/>
  <!-- An unknown model stops the launch here (KeyError) instead of starting no planner. -->
  <let name="planner_package" value="$(eval &quot;{'resworld': 'autoware_tensorrt_e2e', 'mlplanner_1p5stage': 'autoware_tensorrt_e2e', 'mlplanner_2stage': 'autoware_ml_planner'}['$(var model)']&quot;)"/>

  <arg name="vehicle_info_param_path" default="$(find-pkg-share autoware_vehicle_info_utils)/config/vehicle_info.param.yaml"/>
  <arg name="ml_planner_param_path" default="$(find-pkg-share autoware_ml_planner)/config/ml_planner.param.yaml" description="ML-Planner models: autoware_ml_planner's own parameters"/>
  <arg name="build_only" default="false" description="shutdown after the TensorRT engines are built"/>
  <arg name="target_container" default="" description="resworld: container to compose into (empty: own process)"/>

  <arg name="input_pointcloud" default="/sensing/lidar/concatenated/pointcloud"/>
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_steering" default="/vehicle/status/steering_status"/>
  <arg name="input_velocity" default="/vehicle/status/velocity_status"/>
  <arg name="input_traffic_signals" default="/perception/traffic_light_recognition/traffic_signals"/>
  <arg name="input_route" default="/planning/mission_planning/route"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="input_turn_indicators" default="/vehicle/status/turn_indicators_status"/>
  <arg name="input_tracked_objects" default="/perception/object_recognition/tracking/objects" description="ML-Planner models"/>

  <arg name="output_trajectory" default="~/output/trajectory"/>
  <arg name="output_trajectories" default="~/output/trajectories"/>
  <arg name="output_turn_indicators" default="~/output/turn_indicators"/>
  <arg name="output_detected_objects" default="~/output/detected_objects" description="resworld"/>
  <arg name="output_predicted_objects" default="~/output/predicted_objects" description="ML-Planner models"/>
  <arg name="output_debug_traffic_signal" default="~/output/debug/traffic_signal" description="ML-Planner models"/>
  <arg name="output_planning_factors" default="/planning/planning_factors/diffusion_planner" description="ML-Planner models"/>

  <include file="$(find-pkg-share autoware_tensorrt_e2e)/launch/e2e_planner_resworld.launch.xml" if="$(eval &quot;'$(var model)' == 'resworld'&quot;)">
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="vehicle_info_param_path" value="$(var vehicle_info_param_path)"/>
    <arg name="build_only" value="$(var build_only)"/>
    <arg name="target_container" value="$(var target_container)"/>
    <arg name="input_pointcloud" value="$(var input_pointcloud)"/>
    <arg name="input_odometry" value="$(var input_odometry)"/>
    <arg name="input_acceleration" value="$(var input_acceleration)"/>
    <arg name="input_steering" value="$(var input_steering)"/>
    <arg name="input_velocity" value="$(var input_velocity)"/>
    <arg name="input_traffic_signals" value="$(var input_traffic_signals)"/>
    <arg name="input_route" value="$(var input_route)"/>
    <arg name="input_vector_map" value="$(var input_vector_map)"/>
    <arg name="input_turn_indicators" value="$(var input_turn_indicators)"/>
    <arg name="output_trajectory" value="$(var output_trajectory)"/>
    <arg name="output_trajectories" value="$(var output_trajectories)"/>
    <arg name="output_turn_indicators" value="$(var output_turn_indicators)"/>
    <arg name="output_detected_objects" value="$(var output_detected_objects)"/>
  </include>

  <include file="$(find-pkg-share autoware_tensorrt_e2e)/launch/ml_planner_bev.launch.xml" if="$(eval &quot;'$(var model)' == 'mlplanner_1p5stage'&quot;)">
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="ml_planner_param_path" value="$(var ml_planner_param_path)"/>
    <arg name="vehicle_info_param_path" value="$(var vehicle_info_param_path)"/>
    <arg name="build_only" value="$(var build_only)"/>
    <arg name="input_pointcloud" value="$(var input_pointcloud)"/>
    <arg name="input_odometry" value="$(var input_odometry)"/>
    <arg name="input_steering_status" value="$(var input_steering)"/>
    <arg name="input_acceleration" value="$(var input_acceleration)"/>
    <arg name="input_route" value="$(var input_route)"/>
    <arg name="input_traffic_signals" value="$(var input_traffic_signals)"/>
    <arg name="input_tracked_objects" value="$(var input_tracked_objects)"/>
    <arg name="input_vector_map" value="$(var input_vector_map)"/>
    <arg name="input_turn_indicators" value="$(var input_turn_indicators)"/>
    <arg name="output_trajectory" value="$(var output_trajectory)"/>
    <arg name="output_trajectories" value="$(var output_trajectories)"/>
    <arg name="output_predicted_objects" value="$(var output_predicted_objects)"/>
    <arg name="output_turn_indicators" value="$(var output_turn_indicators)"/>
    <arg name="debug/output_traffic_signal" value="$(var output_debug_traffic_signal)"/>
    <arg name="output_planning_factors" value="$(var output_planning_factors)"/>
  </include>

  <!-- autoware_ml_planner's node as its ml_planner.launch.xml starts it, with the release directory override. -->
  <node pkg="autoware_ml_planner" exec="autoware_ml_planner_node" name="ml_planner_node" output="both" if="$(eval &quot;'$(var model)' == 'mlplanner_2stage'&quot;)">
    <param from="$(var ml_planner_param_path)" allow_substs="true"/>
    <param from="$(find-pkg-share autoware_tensorrt_e2e)/config/ml_planner_2stage.param.yaml" allow_substs="true"/>
    <param from="$(var vehicle_info_param_path)" allow_substs="true"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/output/trajectories" to="$(var output_trajectories)"/>
    <remap from="~/output/predicted_objects" to="$(var output_predicted_objects)"/>
    <remap from="~/output/turn_indicators" to="$(var output_turn_indicators)"/>
    <remap from="~/output/debug/traffic_signal" to="$(var output_debug_traffic_signal)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/steering_status" to="$(var input_steering)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/traffic_signals" to="$(var input_traffic_signals)"/>
    <remap from="~/input/tracked_objects" to="$(var input_tracked_objects)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/turn_indicators" to="$(var input_turn_indicators)"/>
    <remap from="/planning/planning_factors/ml_planner" to="$(var output_planning_factors)"/>
    <param name="build_only" value="$(var build_only)"/>
  </node>
</launch>
