<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Artifact location and the file names inside it. The network's own
       description travels with the artifacts as ml_package_<model>.param.yaml
       (autoware_bevfusion convention), so switching models or re-trained
       variants never edits this package. -->
  <arg name="data_path" default="$(env HOME)/autoware_data/OnePlanner" description="ml model artifacts root"/>
  <arg name="model_name" default="resworld"/>
  <arg name="model_path" default="$(var data_path)" description="the model directory itself; the model_name only names the files in it, like the other packages under ~/autoware_data"/>
  <arg name="planner_onnx" default="$(var model_name)_planner.simplified.onnx"/>
  <arg name="extractor_onnx" default="bevfusion_lidar_feature.onnx"/>

  <arg name="model_param_path" default="$(find-pkg-share autoware_tensorrt_e2e)/config/e2e_planner.param.yaml" description="deployment behaviour (model-agnostic)"/>
  <arg name="ml_package_param_path" default="$(var model_path)/ml_package_$(var model_name).param.yaml" description="network description, shipped with the artifacts"/>
  <arg name="vehicle_info_param_path" default="$(find-pkg-share autoware_vehicle_info_utils)/config/vehicle_info.param.yaml"/>
  <arg name="build_only" default="false" description="shutdown node after the TensorRT engine files are built"/>
  <arg name="launch_prefix" default="" description="wrap the node process (e.g. compute-sanitizer, gdb -ex run --args)"/>
  <!-- Empty runs the node in its own process. Naming a container composes it in
       there instead, which is what the cloud's zero-copy handover requires. -->
  <arg name="target_container" default="" description="container to compose into, e.g. /pointcloud_container"/>

  <!-- Sensing input: concatenated point cloud (same source as BEVFusion) -->
  <arg name="input_pointcloud" default="/sensing/lidar/concatenated/pointcloud"/>

  <!-- Context inputs (diffusion-planner-style; subscribed only when the model needs them) -->
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_steering" default="/vehicle/status/steering_status"/>
  <arg name="input_traffic_signals" default="/perception/traffic_light_recognition/traffic_signals"/>
  <arg name="input_route" default="/planning/mission_planning/route"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="input_turn_indicators" default="/vehicle/status/turn_indicators_status"/>

  <arg name="output_trajectory" default="~/output/trajectory"/>
  <arg name="output_trajectories" default="~/output/trajectories"/>
  <!-- The frozen BEVFusion detection head riding along on the extractor graph. Published
       once per LiDAR frame, in that cloud's frame, with autoware_bevfusion's own
       postprocessing; nothing in the planner path reads it. -->
  <arg name="output_detected_objects" default="~/output/detected_objects"/>

  <!-- Standalone, one process of its own: the default, and what a replay or
       a bench run wants. -->
  <node pkg="autoware_tensorrt_e2e" exec="autoware_tensorrt_e2e_node" name="tensorrt_e2e"
        output="both" launch-prefix="$(var launch_prefix)"
        if="$(eval &quot;'$(var target_container)'==''&quot;)">
    <param from="$(var model_param_path)" allow_substs="true"/>
    <param from="$(var ml_package_param_path)" allow_substs="true"/>
    <param from="$(var vehicle_info_param_path)" allow_substs="true"/>
    <param name="build_only" value="$(var build_only)"/>
    <remap from="~/input/pointcloud" to="$(var input_pointcloud)"/>
    <remap from="~/input/pointcloud/cuda" to="$(var input_pointcloud)/cuda"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/steering" to="$(var input_steering)"/>
    <remap from="~/input/traffic_signals" to="$(var input_traffic_signals)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/turn_indicators" to="$(var input_turn_indicators)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/output/trajectories" to="$(var output_trajectories)"/>
    <remap from="~/output/detected_objects" to="$(var output_detected_objects)"/>
  </node>

  <!-- Composed into an existing container. The concatenated cloud reaches this
       node through cuda_blackboard, which hands over a GPU buffer by putting it
       in a per-process singleton and publishing only an instance id: the
       negotiated path resolves only when the publisher and this node share a
       process. Standalone, the node negotiates, disables its compatible
       callback as designed, and then receives nothing at all. Point this at
       the container the CUDA concatenator runs in to get the zero copy.

       No use_intra_process_comms here, exactly as autoware_bevfusion's launch
       has none. The zero-copy handover does not need it: cuda_blackboard enables
       intra-process on its own two subscriptions explicitly
       (IntraProcessSetting::Enable in cuda_blackboard_subscriber.cpp), and the
       publisher counts exactly those when it hands out buffer tickets. That is
       how bevfusion is counted, with the node default left off.

       Turning it on node-wide, as this launch did until 2026-09-14, broke the
       node on the vehicle without an error anyone saw. rclcpp refuses
       intra-process for anything latched (transient_local), publisher or
       subscription, and cuda_blackboard's NegotiatedSubscription creates a
       latched publisher for its supported types with default options, i.e. the
       node's. So the cloud subscriber itself threw in the provider constructor,
       2 ms after the planner engine loaded: the node was loaded, had no cloud
       subscription at all, and reported it only on /diagnostics. The route and
       map subscriptions, also latched, would have thrown the same way one step
       later. The standalone branch above never had the flag, which is why the
       same launch worked there. Reproduced 2026-09-14 in a bare container with
       valid artifacts: "intraprocess communication allowed only with volatile
       durability" 2 ms after "Engine inputs". -->
  <load_composable_node target="$(var target_container)"
                        unless="$(eval &quot;'$(var target_container)'==''&quot;)">
    <!-- No namespace attribute, deliberately. launch_ros combines a composable
         node's own namespace with the enclosing push-ros-namespace through
         prefix_namespace(), which returns the node's namespace unchanged when
         that namespace is absolute. Writing namespace="/" here would therefore
         throw the enclosing namespace away and put the node at the root, while
         the standalone branch above stayed where it was put: the same launch
         would publish on two different sets of topics depending on whether it
         composed, and everything wired to the namespaced path would read an
         empty topic. Omitting it inherits, which is also "/" when nothing was
         pushed, so the container case is unchanged. -->
    <composable_node pkg="autoware_tensorrt_e2e"
                     plugin="autoware::tensorrt_e2e::TensorrtE2eNode"
                     name="tensorrt_e2e">
      <param from="$(var model_param_path)" allow_substs="true"/>
      <param from="$(var ml_package_param_path)" allow_substs="true"/>
      <param from="$(var vehicle_info_param_path)" allow_substs="true"/>
      <param name="build_only" value="$(var build_only)"/>
      <remap from="~/input/pointcloud" to="$(var input_pointcloud)"/>
      <remap from="~/input/pointcloud/cuda" to="$(var input_pointcloud)/cuda"/>
      <remap from="~/input/odometry" to="$(var input_odometry)"/>
      <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
      <remap from="~/input/steering" to="$(var input_steering)"/>
      <remap from="~/input/traffic_signals" to="$(var input_traffic_signals)"/>
      <remap from="~/input/route" to="$(var input_route)"/>
      <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
      <remap from="~/input/turn_indicators" to="$(var input_turn_indicators)"/>
      <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
      <remap from="~/output/trajectories" to="$(var output_trajectories)"/>
      <remap from="~/output/detected_objects" to="$(var output_detected_objects)"/>
    </composable_node>
  </load_composable_node>

</launch>
