{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autoware_stack_evaluator",
  "type": "object",
  "properties": {
    "plugin_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered list of plugin class names to load"
    },
    "use_control_evaluator": {
      "type": "boolean",
      "description": "Enable control evaluator metrics plugin"
    },
    "use_planning_evaluator": {
      "type": "boolean",
      "description": "Enable planning evaluator metrics plugin"
    }
  }
}
