<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="safety_planner_config_dir" default="$(find-pkg-share autoware_safety_planner)/config"/>
  <arg name="safety_planner_param_path" default="$(var safety_planner_config_dir)/safety_planner.param.yaml"/>
  <!-- constraint generator plugins -->
  <arg name="safety_planner_vehicle_kinematics_param_path" default="$(var safety_planner_config_dir)/constraint_generator/vehicle_kinematics.param.yaml"/>
  <arg name="safety_planner_external_velocity_limit_param_path" default="$(var safety_planner_config_dir)/constraint_generator/external_velocity_limit.param.yaml"/>
  <arg name="safety_planner_lane_following_drivable_area_param_path" default="$(var safety_planner_config_dir)/constraint_generator/lane_following_drivable_area.param.yaml"/>
  <arg name="safety_planner_obstacle_stop_param_path" default="$(var safety_planner_config_dir)/constraint_generator/obstacle_stop.param.yaml"/>
  <!-- trajectory planner plugins -->
  <arg name="safety_planner_frenet_sampling_based_planner_param_path" default="$(var safety_planner_config_dir)/trajectory_planner/frenet_sampling_based_planner.param.yaml"/>
  <arg name="safety_planner_mppi_planner_param_path" default="$(var safety_planner_config_dir)/trajectory_planner/mppi_planner.param.yaml"/>

  <!-- Topic remappings -->
  <arg name="input_vector_map" default="~/input/vector_map"/>
  <arg name="input_route" default="~/input/route"/>
  <arg name="input_odometry" default="~/input/odometry"/>
  <arg name="input_acceleration" default="~/input/acceleration"/>
  <arg name="input_objects" default="~/input/objects"/>
  <arg name="input_steering" default="~/input/steering"/>
  <arg name="input_pointcloud" default="~/input/pointcloud"/>
  <!-- The API entry of the rule based stack, a fixed global name, so it is wired here rather
       than left to the caller like the other inputs -->
  <arg name="input_external_velocity_limit_mps" default="/planning/scenario_planning/max_velocity_default"/>
  <arg name="output_candidate_trajectories" default="~/output/candidate_trajectories"/>

  <node pkg="autoware_safety_planner" exec="autoware_safety_planner_node" name="safety_planner_node" output="both">
    <param from="$(var safety_planner_param_path)" allow_substs="true"/>
    <param from="$(var safety_planner_vehicle_kinematics_param_path)" allow_substs="true"/>
    <param from="$(var safety_planner_external_velocity_limit_param_path)" allow_substs="true"/>
    <param from="$(var safety_planner_lane_following_drivable_area_param_path)" allow_substs="true"/>
    <param from="$(var safety_planner_obstacle_stop_param_path)" allow_substs="true"/>
    <param from="$(var safety_planner_frenet_sampling_based_planner_param_path)" allow_substs="true"/>
    <param from="$(var safety_planner_mppi_planner_param_path)" allow_substs="true"/>

    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/objects" to="$(var input_objects)"/>
    <remap from="~/input/steering" to="$(var input_steering)"/>
    <remap from="~/input/pointcloud" to="$(var input_pointcloud)"/>
    <remap from="~/input/external_velocity_limit_mps" to="$(var input_external_velocity_limit_mps)"/>
    <remap from="~/output/candidate_trajectories" to="$(var output_candidate_trajectories)"/>
  </node>
</launch>
