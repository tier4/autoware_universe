<class_libraries>
  <library path="autoware_safety_planner_constraint_plugins">
    <class type="autoware::safety_planner::experiment::VehicleKinematicsConstraintGenerator"
           base_class_type="autoware::safety_planner::ConstraintGeneratorInterface">
      <description>Emits the ScalarBound constraints of the vehicle kinematics</description>
    </class>
    <class type="autoware::safety_planner::experiment::LaneFollowingDrivableAreaConstraintGenerator"
           base_class_type="autoware::safety_planner::ConstraintGeneratorInterface">
      <description>Builds the drivable area from the lane bounds of the lanelets on the route</description>
    </class>
    <class type="autoware::safety_planner::experiment::SimpleDrivableAreaConstraintGenerator"
           base_class_type="autoware::safety_planner::ConstraintGeneratorInterface">
      <description>Takes the reference_path widened by a constant half width and extended at both ends as the drivable area, emitted as two boundaries</description>
    </class>
    <class type="autoware::safety_planner::experiment::NextLaneletSpeedLimitConstraintGenerator"
           base_class_type="autoware::safety_planner::ConstraintGeneratorInterface">
      <description>Debug: emits a regional velocity bound over the lanelet following the current one</description>
    </class>
    <class type="autoware::safety_planner::experiment::ObstacleStopConstraintGenerator"
           base_class_type="autoware::safety_planner::ConstraintGeneratorInterface">
      <description>Emits one rigid-body KeepOut per predicted object, along its most likely predicted path</description>
    </class>
  </library>
  <library path="autoware_safety_planner_trajectory_planner_plugins">
    <class type="autoware::safety_planner::experiment::FrenetSamplingBasedPlanner"
           base_class_type="autoware::safety_planner::TrajectoryPlannerInterface">
      <description>Samples terminal states in Frenet coordinates and joins them with quintic polynomials, then takes the cheapest candidate that passes the projected views of the constraint IR</description>
    </class>
  </library>
</class_libraries>
