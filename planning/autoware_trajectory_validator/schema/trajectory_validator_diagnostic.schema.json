{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parameters for Trajectory Validator Diagnostic",
  "type": "object",
  "definitions": {
    "trajectory_validator_diagnostic": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of diagnostic status bindings. Each entry encodes one binding as filter_name:action:diagnostic_name, where filter_name is the validator short name returned by plugin->get_name(), action is one of none/comfortable/moderate/emergency, and diagnostic_name is the DiagnosticStatus name to publish when that action fires on the best candidate trajectory.",
          "default": [
            "uncrossable_boundary_departure_filter:moderate:trajectory_validator_uncrossable_boundary_departure_danger"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "properties": {
    "/**": {
      "type": "object",
      "properties": {
        "ros__parameters": {
          "type": "object",
          "properties": {
            "trajectory_validator_diagnostic": {
              "$ref": "#/definitions/trajectory_validator_diagnostic"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": ["ros__parameters"],
      "additionalProperties": false
    }
  },
  "required": ["/**"],
  "additionalProperties": false
}
