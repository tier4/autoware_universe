<launch>
  <arg name="container_type" default="component_container"/>
  <let name="use_agnocast" value="$(env ENABLE_AGNOCAST 0)"/>
  <let name="container_package" value="rclcpp_components" unless="$(eval &quot;'$(var use_agnocast)' == '1'&quot;)"/>
  <let name="container_package" value="agnocast_components" if="$(eval &quot;'$(var use_agnocast)' == '1'&quot;)"/>
  <let name="container_executable" value="$(var container_type)" unless="$(eval &quot;'$(var use_agnocast)' == '1'&quot;)"/>
  <let name="container_executable" value="agnocast_component_container_cie" if="$(eval &quot;'$(var use_agnocast)' == '1'&quot;)"/>

  <arg name="trajectory_modifier_param_path" default="$(find-pkg-share autoware_trajectory_modifier)/config/trajectory_modifier.param.yaml"/>
  <arg name="input_candidate_trajectories" default="/planning/diffusion_planner/candidate_trajectories"/>
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_objects" default="/perception/object_recognition/objects"/>
  <arg name="input_pointcloud" default="/perception/obstacle_segmentation/pointcloud"/>
  <arg name="input_route" default="/planning/mission_planning/route"/>
  <arg name="input_traffic_signals" default="/perception/traffic_light_recognition/traffic_signals"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="input_external_velocity_limit_mps" default="/planning/scenario_planning/max_velocity_default"/>
  <arg name="input_scenario_max_velocity_mps" default="/planning/scenario_planning/max_velocity"/>
  <arg name="input_velocity_limit_clear_command" default="/planning/scenario_planning/clear_velocity_limit"/>
  <arg name="output_candidate_trajectories" default="~/output/candidate_trajectories"/>

  <node pkg="autoware_trajectory_modifier" exec="autoware_trajectory_modifier_node" name="trajectory_modifier" output="screen">
    <env name="LD_LIBRARY_PATH" value="/opt/acados/lib:$(env LD_LIBRARY_PATH)"/>
    <!-- Small acados/HPIPM QPs jitter badly with a BLAS thread pool. -->
    <env name="OPENBLAS_NUM_THREADS" value="1"/>
    <env name="MKL_NUM_THREADS" value="1"/>
    <param from="$(var trajectory_modifier_param_path)" allow_substs="true"/>
    <param from="$(var common_param_path)" allow_substs="true"/>
    <param from="$(var elastic_band_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_point_fixer_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_extender_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_spline_smoother_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_qp_smoother_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_velocity_optimizer_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_kinematic_feasibility_enforcer_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_mpt_optimizer_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_temporal_mpt_optimizer_param_path)" allow_substs="true"/>
    <param from="$(var trajectory_time_sequence_raw_optimizer_param_path)" allow_substs="true"/>
    <param from="$(var vehicle_info_param_path)" allow_substs="true"/>
    <param from="$(var simulator_model_param_path)"/>
    <param from="$(var mppi_param_path)" allow_substs="true"/>
    <remap from="~/input/trajectories" to="$(var input_trajectories)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/steering_status" to="$(var input_steering_status)"/>
    <remap from="~/input/objects" to="$(var input_objects)"/>
    <remap from="~/input/tracked_objects" to="$(var input_tracked_objects)"/>
    <remap from="~/input/pointcloud" to="$(var input_pointcloud)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/traffic_signals" to="$(var input_traffic_signals)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/external_velocity_limit_mps" to="$(var input_external_velocity_limit_mps)"/>
    <remap from="~/input/scenario_max_velocity_mps" to="$(var input_scenario_max_velocity_mps)"/>
    <remap from="~/input/velocity_limit_clear_command" to="$(var input_velocity_limit_clear_command)"/>
    <remap from="~/input/mpc_predicted_trajectory" to="$(var input_mpc_predicted_trajectory)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/output/trajectories" to="$(var output_trajectories)"/>
    <remap from="~/output/current_velocity_limit_mps" to="$(var output_current_velocity_limit_mps)"/>
  </node>
</launch>
