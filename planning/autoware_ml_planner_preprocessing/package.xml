<?xml version="1.0"?>
<package format="3">
  <name>autoware_ml_planner_preprocessing</name>
  <version>0.52.0</version>
  <description>Build ML-Planner input tensors from T4Scene.</description>

  <maintainer email="daniel.sanchez@tier4.jp">Daniel Sanchez</maintainer>
  <maintainer email="yukinari.hisaki.2@tier4.jp">Yukinari Hisaki</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>autoware_lanelet2_extension</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_utils_math</depend>
  <depend>eigen</depend>
  <depend>lanelet2_core</depend>
  <depend>libexpected-dev</depend>
  <depend>t4scene</depend>
  <depend>xtensor</depend>

  <build_depend>boost</build_depend>
  <build_depend>pybind11_vendor</build_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
